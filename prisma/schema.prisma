// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses the Vercel Postgres URL
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// A model for your users
model User {
  id        String  @id @default(cuid()) // Unique ID generated by Prisma
  googleId  String  @unique // The "sub" ID from Google
  email     String  @unique
  channelName String
  profilePicture String?
  videos    Video[] // A user can have many videos
}

// A model for your videos
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   // URL from Vercel Blob
  thumbnailUrl String?
  createdAt   DateTime @default(now())
  
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
}